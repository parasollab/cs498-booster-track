# Course-wide DeltaAI settings. Sourced by every script in scripts/.
# STAFF: fill these in once the allocation is granted, then commit.
export COURSE_ACCOUNT="bign-dtai-gh"
export COURSE_PARTITION_BATCH="ghx4"
export COURSE_PARTITION_INTERACTIVE="ghx4-interactive"
export COURSE_WORK_DIR="/work/hdd/${COURSE_ACCOUNT}"
export COURSE_MAX_TRAIN_HOURS=4

# Where training output lands. The course keeps all training output inside the
# repo, in one log root shared by every assignment, so this is derived from the
# location of this file rather than from $COURSE_WORK_DIR.
# Must stay in sync with the paths in scripts/train.sbatch.
export COURSE_LOG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/logs"

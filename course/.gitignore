logs/
# hw0/logs/ must exist in a fresh clone: Slurm opens train.sbatch's
# --output file itself and will fail the job rather than create the
# directory. Track the directory, ignore everything that lands in it.
!hw0/logs/
hw0/logs/**
!hw0/logs/.gitkeep
